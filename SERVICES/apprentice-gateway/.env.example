# Apprentice Gateway env — template
# Copy to /etc/apprentice-gateway.env on the server, populate, chmod 600

# Stripe — POPULATE WITH TEST KEYS FIRST · flip to LIVE only after E2E passes
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin token for /admin/* endpoints — generate with `openssl rand -hex 32`
ADMIN_TOKEN=

# Founding cohort cap
FOUNDING_CAP=30
CHARACTER_FOUNDING_CAP=7

# Landing URLs
LANDING_BASE_URL=https://fullpotential.com
CHECKOUT_SUCCESS_URL=https://fullpotential.com/apprentice/welcome
CHECKOUT_CANCEL_URL=https://fullpotential.com/apprentice/

# Provisioning feature flags — ALL OFF initially · flip one at a time after verify
PROVISION_CHAMPION_CARD=0
PROVISION_BRAIN_ACCOUNT=0
PROVISION_TG_INVITE=0
PROVISION_WELCOME_EMAIL=0

# Character tier provisioning flags (default OFF)
CHAR_PROVISION_BRAIN_ACCOUNT=0
CHAR_PROVISION_IDENTITY_STACK=0
CHAR_PROVISION_TG_INVITE=0
CHAR_PROVISION_WELCOME_PACKET=0
CHAR_PROVISION_NARRATOR=0

# Downstream services
CHAMPION_SIGN_URL=http://127.0.0.1:8770
CHAMPION_SIGN_ADMIN_TOKEN=
BRAIN_URL=http://127.0.0.1:8000
BRAIN_ADMIN_TOKEN=
TG_BOT_URL=http://127.0.0.1:8766
TG_BOT_ADMIN_TOKEN=
TG_APPRENTICE_CHANNEL=@apprentices
TG_CHARACTER_CHANNEL=@characters
MAIL_URL=http://127.0.0.1:8770
MAIL_ADMIN_TOKEN=
NARRATOR_URL=http://127.0.0.1:8771
NARRATOR_ADMIN_TOKEN=
ALERTS_URL=http://127.0.0.1:8766

# Character first-1:1 booking link
CHAR_BOOKING_URL=https://cal.com/jamessunheart/character-onboarding

# Products file written by setup_stripe.py
APPRENTICE_PRODUCTS_FILE=/etc/apprentice-gateway-products.json

# DB path
DB_PATH=/var/lib/apprentice-gateway/apprentice.db
