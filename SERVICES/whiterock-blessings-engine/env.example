# WhiteRock Blessings Engine - Environment Configuration
# Copy to .env and fill in values

# Application
APP_NAME=WhiteRock Blessings Engine
APP_VERSION=2.1.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8020

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/whiterock

# JWT Authentication
JWT_SECRET=your-secure-jwt-secret-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Stripe (Payment Processing)
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# SendGrid (Email)
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=blessings@whiterock.us
SENDGRID_FROM_NAME=WhiteRock Ministry

# Redis (for Celery)
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CORA Configuration
CORA_DECAY_RATE=0.10
CORA_DECAY_THRESHOLD_MONTHS=12
CORA_DECAY_WARNING_DAYS=30

# UDC Registry (Optional)
REGISTRY_URL=http://198.54.123.234:8000
ORCHESTRATOR_URL=http://198.54.123.234:8010
SERVICE_ID=whiterock-blessings

# Compliance
CURRENT_DISCLOSURE_VERSION=1.0.0
MIN_MEMBERSHIP_DAYS_FOR_BLESSING=30
