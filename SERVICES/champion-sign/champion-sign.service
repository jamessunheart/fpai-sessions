[Unit]
Description=Champion Sign — Coherent Champions of CHRIST signature webhook
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/fpai/services/champion-sign
Environment="CHAMPION_DATA_DIR=/var/lib/full-potential/champions"
ExecStart=/opt/fpai/services/champion-sign/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8771
Restart=on-failure
RestartSec=5
User=root
Group=root

[Install]
WantedBy=multi-user.target
