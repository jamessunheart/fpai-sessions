# Sunheart Brain — compose environment (copy to /root/sh-brain-secrets/brain.env, chmod 600)
#
# Generate secrets with:
#   openssl rand -hex 32     # for JWT
#   openssl rand -base64 24  # for passwords
#
# DO NOT commit the real values — this .example file goes in git with placeholders.

# --- Public URL (must match the nginx vhost and DNS) ---
APPFLOWY_BASE_URL=https://brain.sunheart.com
APPFLOWY_WEBSOCKET_BASE_URL=wss://brain.sunheart.com/ws

# --- Postgres ---
POSTGRES_USER=appflowy
POSTGRES_PASSWORD=__REPLACE_WITH_random_24byte_base64__
POSTGRES_DB=appflowy
# The gotrue schema uses its own admin role (appflowy_cloud image creates it);
# set the same password here.
GOTRUE_POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

# Password the brain-index service uses to connect (least-priv role).
BRAIN_INDEX_DB_PASSWORD=__REPLACE_WITH_random_24byte_base64__

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=appflowyminio
MINIO_ROOT_PASSWORD=__REPLACE_WITH_random_24byte_base64__

# --- GoTrue (auth) ---
GOTRUE_JWT_SECRET=__REPLACE_WITH_random_32byte_hex__
GOTRUE_ADMIN_EMAIL=admin@sunheart.com
GOTRUE_ADMIN_PASSWORD=__REPLACE_WITH_random_24byte_base64__
# Keep signup disabled; we provision users via admin API.
GOTRUE_DISABLE_SIGNUP=true

# --- SMTP (Resend, reuses the sibling zen-village-brain config) ---
# Fill these in after you've verified sunheart.com on Resend (or reuse onboarding@resend.dev
# for Phase A).
GOTRUE_SMTP_HOST=smtp.resend.com
GOTRUE_SMTP_PORT=465
GOTRUE_SMTP_USER=resend
GOTRUE_SMTP_PASS=__REPLACE_WITH_resend_api_key__
GOTRUE_SMTP_ADMIN_EMAIL=onboarding@resend.dev

# --- Owner (James's account — created via GoTrue admin API) ---
SH_OWNER_EMAIL=james.rick.stinson@gmail.com
SH_OWNER_PASSWORD=__REPLACE_WITH_random_24byte_base64__

# --- Embedding providers ---
# Local Ollama — used for bulk ingest (free, runs on Secondary's existing ollama at :11434)
OLLAMA_BASE=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI — used for high-value concept dedup + semantic queries when enabled
OPENAI_API_KEY=__OPTIONAL__
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Logging ---
RUST_LOG=info
