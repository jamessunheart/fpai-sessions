# STreasury Bot — environment template.
# Copy to .env (local) or /etc/streasury-bot/streasury.env (server, root:streasury 0640).
# Never commit a populated .env.

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Get this from @BotFather. Treat the value committed to chat as compromised
# and rotate via /revoke before the bot goes into production.
TELEGRAM_BOT_TOKEN=

# Your Telegram numeric user ID (NOT a chat id). Open Telegram, message
# @userinfobot, copy the "Id" field. The bot ignores everyone else.
OWNER_TG_ID=

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides.
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1

# Default for /ask: which single model to use. "claude" or "openai".
ASK_DEFAULT=claude

# ─── Database ─────────────────────────────────────────────────────────────────
# Reuses the brain Postgres on Brain server. Schema 'streasury' isolates us.
# Local dev: point this at any Postgres 14+ instance.
DATABASE_URL=postgres://streasury:changeme@127.0.0.1:25432/appflowy

# ─── Behaviour ────────────────────────────────────────────────────────────────
# When true, AI-parsed intents are written without a confirm step. Default off
# (safer). Recommended to keep off until you trust the parser.
AUTO_CONFIRM=false

# Default currency for /log when not specified.
DEFAULT_CURRENCY=USD

# CoinGecko API used for crypto valuations (free tier, no key needed for basic).
COINGECKO_BASE=https://api.coingecko.com/api/v3

# ─── HTTP server ──────────────────────────────────────────────────────────────
HTTP_HOST=0.0.0.0
HTTP_PORT=8620

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
