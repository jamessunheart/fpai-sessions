  "cora_system": {
    "description": "Non-transferable Community Vitality Credits",
    "earning_rates": {
      "tithe": "1 CORA per $10 donated",
      "service": "5 CORA per hour of volunteer service"
    },
    "decay": {
      "grace_period_days": 30,
      "weekly_decay_rate": 0.02,
      "minimum_balance": 0
    },
    "tiers": [
      { "name": "Seeker", "min_cora": 0, "max_cora": 99, "privileges": ["basic_access"] },
      { "name": "Steward", "min_cora": 100, "max_cora": 499, "privileges": ["request_blessings", "view_capacity"] },
      { "name": "Elder", "min_cora": 500, "max_cora": 999, "privileges": ["committee_voting", "view_pending"] },
      { "name": "Pillar", "min_cora": 1000, "max_cora": null, "privileges": ["full_governance", "audit_access"] }
    ]
  },
  "blessing_states": {
    "flow": "draft → pending → committee_review → (info_requested) → approved/denied → disbursed → closed",
    "states": [
      { "state": "draft", "description": "Member is preparing request" },
      { "state": "pending", "description": "Submitted, awaiting initial review" },
      { "state": "committee_review", "description": "Under committee evaluation" },
      { "state": "info_requested", "description": "Additional information needed" },
      { "state": "approved", "description": "Approved, pending disbursement" },
      { "state": "denied", "description": "Request was not approved" },
      { "state": "disbursed", "description": "Funds have been sent" },
      { "state": "closed", "description": "Request complete" }
    ]
  },
  "api_endpoints": {
    "public": [
      { "method": "POST", "path": "/members/register", "description": "Register new member" },
      { "method": "POST", "path": "/members/login", "description": "Authenticate and get tokens" },
      { "method": "GET", "path": "/health", "description": "Service health check" }
    ],
    "authenticated": [
      { "method": "GET", "path": "/members/me", "description": "Get current member profile" },
      { "method": "POST", "path": "/members/refresh", "description": "Refresh access token" },
      { "method": "POST", "path": "/members/logout", "description": "Invalidate tokens" },
      { "method": "POST", "path": "/tithes/", "description": "Submit a tithe" },
      { "method": "GET", "path": "/tithes/history", "description": "Get tithe history" },
      { "method": "GET", "path": "/cora/balance", "description": "Get CORA balance" },
      { "method": "GET", "path": "/cora/tiers", "description": "Get tier information" },
      { "method": "POST", "path": "/blessings/request", "description": "Submit blessing request" },
      { "method": "GET", "path": "/blessings/my-requests", "description": "Get own requests" },
      { "method": "GET", "path": "/capacity", "description": "Community blessing capacity" }
    ],
    "elder_plus": [
      { "method": "GET", "path": "/blessings/pending", "description": "View pending requests" },
      { "method": "POST", "path": "/blessings/{id}/transition", "description": "Transition blessing state" },
      { "method": "POST", "path": "/blessings/{id}/vote", "description": "Cast committee vote" }
    ],
    "admin": [
      { "method": "GET", "path": "/audit/logs", "description": "Query audit logs" },
      { "method": "GET", "path": "/audit/compliance-report", "description": "Generate compliance report" },
      { "method": "POST", "path": "/cora/grant", "description": "Admin grant CORA" },
      { "method": "GET", "path": "/metrics", "description": "Prometheus metrics" }
    ]
