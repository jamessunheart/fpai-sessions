<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sunheart.narrator-health</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/jamessunheart/FPAI_Cockpit/infra/scripts/narrator_health.sh</string>
    </array>
