<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.fpai.vault-sync</string>

  <!--
    Two-way sync every 30 minutes:
      1. mirror_pull.py  — server 162 → Obsidian vault (BRAIN STATE, HOT STATE, BRAIN DIGEST)
      2. vault_ingest.py — Obsidian vault → server 162 brain_index (James's human notes)

    After this runs James sees what Ember sees. Ember sees what James wrote.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>
      /usr/bin/python3 /Users/jamessunheart/FPAI_Cockpit/tools/decisions/mirror_pull.py \
        --repo /Users/jamessunheart/FPAI_Cockpit \
        >> /Users/jamessunheart/.config/fpai/vault_sync/vault-sync.stdout.log 2>> /Users/jamessunheart/.config/fpai/vault_sync/vault-sync.stderr.log ;
      /usr/bin/python3 /Users/jamessunheart/FPAI_Cockpit/tools/decisions/vault_ingest.py \
        >> /Users/jamessunheart/.config/fpai/vault_sync/vault-sync.stdout.log 2>> /Users/jamessunheart/.config/fpai/vault_sync/vault-sync.stderr.log
    </string>
  </array>

  <!-- Every 30 minutes — matches HOT_STATE refresh cadence on server 162 -->
  <key>StartInterval</key><integer>1800</integer>

  <!-- Sync immediately on load -->
  <key>RunAtLoad</key><true/>

  <key>StandardOutPath</key><string>/Users/jamessunheart/.config/fpai/vault_sync/launchd.stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/jamessunheart/.config/fpai/vault_sync/launchd.stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/jamessunheart</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/usr/local/bin</string>
  </dict>
</dict>
</plist>
