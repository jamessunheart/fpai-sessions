[Unit]
Description=FPAI Proactive Failure Watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=FPAI_SURFACE=auto-loop
WorkingDirectory=/opt/fpai-build/FPAI_Cockpit
ExecStart=/usr/bin/env python3 /opt/fpai-build/FPAI_Cockpit/tools/failure_watchdog/watchdog.py --send-alert

