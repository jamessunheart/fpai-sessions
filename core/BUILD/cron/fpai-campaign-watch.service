[Unit]
Description=FPAI Meta campaign watch report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/fpai-build/FPAI_Cockpit
Environment=FPAI_SURFACE=systemd:fpai-campaign-watch
Environment=FPAI_REPO=/opt/fpai-build/FPAI_Cockpit
Environment=FPAI_ADS_STATUS_PATH=/root/.config/fpai/ads/status.json
Environment=FPAI_ADS_HOT_STATE_PATH=/root/.config/fpai/hot_memory/ads_status.json
Environment=FPAI_ALLOCATION_LEDGER=/root/.config/fpai/allocation/ledger.jsonl
Environment=META_CAMPAIGN_ID=52555196349772
Environment=META_AD_ACCOUNT_ID=act_71883338
EnvironmentFile=-/etc/sh-brain/curator.env
EnvironmentFile=-/opt/fpai/services/ad-portal/.env
EnvironmentFile=-/opt/fpai/sparket-engine/.env
ExecCondition=/bin/bash -lc '[ "${CAMPAIGN_WATCH_DISABLE:-0}" != "1" ] && [ ! -f /opt/fpai-build/.campaign_watch_disabled ]'
ExecStart=/bin/bash -lc 'PY=/opt/sh-brain-src/.venv/bin/python; if [ ! -x "$PY" ]; then PY=/usr/bin/python3; fi; exec "$PY" /opt/fpai-build/FPAI_Cockpit/tools/ads/campaign_watch.py --once'

