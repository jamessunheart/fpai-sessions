[Unit]
Description=FPAI Awareness Reliability Probe
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=FPAI_SURFACE=auto-loop
WorkingDirectory=/opt/fpai-build/FPAI_Cockpit
ExecStart=/opt/fpai-build/FPAI_Cockpit/core/BUILD/cron/fpai-awareness-reliability-run.sh
