[Unit]
Description=FPAI Awareness Reliability Probe
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=FPAI_SURFACE=auto-loop
WorkingDirectory=/opt/fpai-build/FPAI_Cockpit
ExecStart=/usr/bin/env python3 /opt/fpai-build/FPAI_Cockpit/tools/awareness/reliability_probe.py --send-alert --source timer --threshold 0.95
