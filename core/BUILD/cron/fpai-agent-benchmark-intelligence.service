[Unit]
Description=FPAI per-agent recursive benchmarks

[Service]
Type=oneshot
WorkingDirectory=/opt/fpai-build/FPAI_Cockpit
Environment=PYTHONUNBUFFERED=1
Environment=BENCHMARKS_PROPOSE_LIVE=1
Environment=BENCHMARKS_QUEUE_LIVE=1
ExecStart=/usr/bin/env python3 -B -m tools.benchmarks.run_all_benchmarks
