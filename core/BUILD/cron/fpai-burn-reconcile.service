[Unit]
Description=FPAI provider-side burn reconciliation
After=network-online.target fpai-campaign-watch.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/fpai-build/FPAI_Cockpit
Environment=FPAI_SURFACE=systemd:fpai-burn-reconcile
Environment=FPAI_REPO=/opt/fpai-build/FPAI_Cockpit
Environment=FPAI_BURN_REPORT_DIR=/root/.config/fpai/burn_audit/reports
Environment=FPAI_ALLOCATION_LEDGER=/root/.config/fpai/allocation/ledger.jsonl
Environment="FPAI_VAULT=/root/Documents/FPOS/Full Potential OS"
Environment=META_AD_ACCOUNT_ID=act_71883338
EnvironmentFile=-/etc/sh-brain/curator.env
EnvironmentFile=-/opt/fpai/services/ad-portal/.env
EnvironmentFile=-/opt/fpai/sparket-engine/.env
ExecCondition=/bin/bash -lc '[ "${BURN_RECONCILE_DISABLE:-0}" != "1" ] && [ ! -f /opt/fpai-build/.burn_reconcile_disabled ]'
ExecStart=/bin/bash -lc 'PY=/opt/sh-brain-src/.venv/bin/python; if [ ! -x "$PY" ]; then PY=/usr/bin/python3; fi; "$PY" /opt/fpai-build/FPAI_Cockpit/tools/burn/audit.py || true; "$PY" /opt/fpai-build/FPAI_Cockpit/tools/burn/reconcile.py || true'
