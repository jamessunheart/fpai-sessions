[Unit]
Description=FPAI Public Sunheart Telegram bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/fpai-public-bot.env
Environment=PYTHONPATH=/opt/fpai-build/FPAI_Cockpit
Environment=PUBLIC_CHAT_LIVE=0
WorkingDirectory=/opt/fpai-build/FPAI_Cockpit
ExecStart=/usr/bin/env python3 -m tools.public_bot.bot
Restart=always
RestartSec=10
StateDirectory=fpai-public-bot
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
