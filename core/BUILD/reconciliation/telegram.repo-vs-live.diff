+async def send_typing(chat_id: int | str | None = None) -> None:
+    """Send 'typing' chat action — shows '...' to user while synthesis runs."""
+    if not BOT_TOKEN:
+        return
+    cid = chat_id or CHAT_ID
+    url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendChatAction"
+    try:
+        async with httpx.AsyncClient(timeout=5) as client:
+            await client.post(url, json={"chat_id": cid, "action": "typing"})
+    except Exception:
+        pass
+
+
+async def send_and_get_id(text: str, *, chat_id: int | str | None = None, parse_mode: str = "HTML") -> int | None:
+    """Like send() but returns the message_id so it can be edited for streaming."""
+    if not enabled():
+        return None
+    cid = chat_id or CHAT_ID
+    url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage"
+    try:
+        async with httpx.AsyncClient(timeout=15) as client:
+            r = await client.post(url, json={
+                "chat_id": cid,
+                "text": text,
+                "parse_mode": parse_mode,
+                "disable_web_page_preview": True,
+            })
+            if r.status_code == 200:
+                return r.json().get("result", {}).get("message_id")
+    except Exception as e:
+        log.warning("telegram send_and_get_id error: %s", e)
+    return None
+
