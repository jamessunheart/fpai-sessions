+async def _ollama_stream(system: str, user: str, max_tokens: int, temperature: float, model: str | None = None):
+    """Async generator yielding text chunks from ollama streaming API."""
+    import asyncio as _asyncio
+    _model = model or OLLAMA_MODEL
+    async with httpx.AsyncClient(timeout=240) as client:
+        async with client.stream(
+            "POST",
+            f"{OLLAMA_BASE}/api/chat",
+            json={
+                "model": _model,
+                "stream": True,
+                "options": {"temperature": temperature, "num_predict": max_tokens},
+                "messages": [
+                    {"role": "system", "content": system},
+                    {"role": "user", "content": user},
+                ],
+            },
+        ) as resp:
+            resp.raise_for_status()
+            async for line in resp.aiter_lines():
+                if not line.strip():
+                    continue
+                try:
+                    chunk = json.loads(line)
+                except json.JSONDecodeError:
+                    continue
+                token = (chunk.get("message") or {}).get("content", "")
+                if token:
+                    yield token
+                if chunk.get("done"):
+                    break
+
+
+async def synthesis_complete(
+    system: str,
+    user: str,
+    *,
+    max_tokens: int = 380,
+    temperature: float = 0.5,
+    on_token=None,
+) -> LLMResult:
+    """Chat synthesis: claude-cli first (Sonnet quality, $0 via Max subscription),
+    streaming ollama-3b fallback (fast first token, $0 local).
+    If on_token callback is provided, streams chunks to it via the ollama fallback path.
+    """
+    prompt_hash = hashlib.sha1((system + "\n" + user).encode()).hexdigest()
+    fallback_model = os.environ.get("CURATOR_SYNTHESIS_MODEL", "llama3.2:3b")
+
+    # Primary: claude -p (Sonnet 4.6 quality, $0 flat-rate Max subscription)
+    try:
+        result = await _claude_cli(system, user, max_tokens, temperature, prompt_hash)
+        if result.text.strip():
+            return result
+    except Exception as _ce:
+        log.debug("claude-cli synthesis failed (%s), using ollama fallback", _ce)
+
+    # Fallback: streaming ollama for fast first-token UX
+    if on_token is not None:
+        tokens = []
+        try:
+            async for chunk in _ollama_stream(system, user, max_tokens, temperature, model=fallback_model):
+                tokens.append(chunk)
+                try:
+                    await on_token(chunk)
+                except Exception:
+                    pass
+            text = "".join(tokens)
+            return LLMResult(text=text, model=f"ollama:{fallback_model}",
+                             prompt_sha1=prompt_hash, tokens_in=0, tokens_out=len(tokens))
+        except Exception as _se:
+            log.warning("ollama streaming failed (%s), falling back to blocking", _se)
+            # If streaming breaks mid-way and we already have partial text, return it
+            if tokens:
+                text = "".join(tokens)
+                return LLMResult(text=text, model=f"ollama:{fallback_model}",
+                                 prompt_sha1=prompt_hash, tokens_in=0, tokens_out=len(tokens))
+
+    return await _ollama(system, user, max_tokens, temperature, prompt_hash, model=fallback_model)
