+async def _claude_cli(system: str, user: str, max_tokens: int, temperature: float, prompt_hash: str) -> LLMResult:
+    """Run claude -p via subprocess — uses Claude Max subscription ($0 marginal).
+    Falls back to ollama if claude CLI not found or exits nonzero."""
+    import asyncio as _asyncio
+    import shutil as _shutil
+    prompt = f"{system}\n\n{user}"
+    cli = _shutil.which("claude") or "claude"
+    try:
+        proc = await _asyncio.create_subprocess_exec(
+            cli, "-p", prompt,
+            stdout=_asyncio.subprocess.PIPE,
+            stderr=_asyncio.subprocess.PIPE,
+        )
+        try:
+            stdout, stderr = await _asyncio.wait_for(proc.communicate(), timeout=90)
+        except _asyncio.TimeoutError:
+            proc.kill()
+            raise RuntimeError("claude -p timed out after 90s")
+        if proc.returncode != 0:
+            err = stderr.decode(errors="replace")[:200]
+            raise RuntimeError(f"claude -p exit {proc.returncode}: {err}")
+        text = stdout.decode(errors="replace").strip()
+        return LLMResult(text=text, model="claude-cli", prompt_sha1=prompt_hash, tokens_in=0, tokens_out=0)
+    except FileNotFoundError:
+        log.warning("claude CLI not found, falling back to ollama")
+        return await _ollama(system, user, max_tokens, temperature, prompt_hash)
+    except Exception as exc:
+        log.warning("claude-cli failed (%s), falling back to ollama", exc)
+        return await _ollama(system, user, max_tokens, temperature, prompt_hash)
 
 
