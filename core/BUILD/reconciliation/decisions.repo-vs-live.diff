+_AFFIRM = re.compile(r"\b(yes|yeah|yep|build|do it|go|approve|approved|sure|ok|okay|proceed|ship|let'?s)\b", re.I)
+_NEGATE = re.compile(r"\b(no|not now|skip|hold|don'?t|stop|later|nope|cancel|nah)\b", re.I)
