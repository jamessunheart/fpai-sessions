+    """James asks to merge from his phone. Only a 'built' (AI-approved) build can be requested."""
+    async with connect() as conn:
+        async with conn.cursor() as cur:
+            await cur.execute("SELECT build_branch, build_status FROM brain_index.decisions WHERE id=%s", (did,))
+            r = await cur.fetchone()
+            if not r:
+                return ("missing", None)
+            branch, status = r
+            if not branch:
+                return ("no_build", None)
+            if status == "merged":
+                return ("already", branch)
+            if status not in ("built",):
+                return (status or "not_ready", branch)
+            await cur.execute("UPDATE brain_index.decisions SET build_status='merge_requested' WHERE id=%s", (did,))
+            return ("ok", branch)
+
+
+async def pending_merges():
+    """Daemon reads builds James approved for merge."""
+    await ensure_table()
+    async with connect() as conn:
+        async with conn.cursor() as cur:
+            await cur.execute(
+                "SELECT id, build_branch, question FROM brain_index.decisions "
+                "WHERE build_status='merge_requested' AND build_branch <> '' ORDER BY id")
+            return [dict(zip(["id","build_branch","question"], r)) for r in await cur.fetchall()]
+
+
+async def mark_merged(did, ok=True):
+    async with connect() as conn:
+        async with conn.cursor() as cur:
+            await cur.execute("UPDATE brain_index.decisions SET build_status=%s WHERE id=%s",
+                              ("merged" if ok else "merge_failed", did))
+    await write_receipt("merge" if ok else "merge-failed", did,
+                        f"{'MERGED' if ok else 'MERGE FAILED'} from phone-approval")
+
+
+async def handle_merge(chat_id, did):
+    status, branch = await request_merge(did)
+    if status == "ok":
+        return (f"🔀 <b>Merge approved</b> [{did}] — <code>{tg._esc(branch)}</code>\n"
+                f"<i>Running the gate (tests + independent AI review + protected-zone), then merging to "
+                f"feat/headless-build. I'll confirm. (main still needs the terminal + Ember's audit.)</i>")
+    return {
+        "missing":   f"🤔 No decision <code>{tg._esc(did)}</code> on file.",
+        "no_build":  f"🤔 [{did}] has no built branch to merge yet.",
+        "already":   f"✓ [{did}] is already merged.",
+    }.get(status, f"⚠️ [{did}] isn't ready to merge (status: {tg._esc(str(status))}). It must be built + AI-approved first.")
+
