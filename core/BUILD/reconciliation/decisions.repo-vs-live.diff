+def _format(row: dict, n_left: int) -> str:
+    """Render a full Decision Card — only the fields that are present."""
+    e = tg._esc
+    L = [f"🟡 <b>Decision needed</b> [{row['id']}]", e(row["question"])]
+    if row.get("why_surfaced"):   L.append(f"\n<b>Why surfaced:</b> {e(row['why_surfaced'])}")
+    if row.get("recommendation"): L.append(f"<b>Recommendation:</b> {e(row['recommendation'])}")
+    if row.get("options"):        L.append(f"<b>Options:</b> {e(' / '.join(row['options'].split('|')))}")
+    meta = []
+    if row.get("risk_class"):     meta.append(f"Risk: {e(row['risk_class'])}")
+    if row.get("attention_cost"): meta.append(f"Attention: {e(row['attention_cost'])}")
+    if row.get("deadline"):       meta.append(f"Deadline: {e(row['deadline'])}")
+    if meta: L.append("<i>" + " · ".join(meta) + "</i>")
+    if row.get("proof_expected"): L.append(f"<b>Proof expected:</b> {e(row['proof_expected'])}")
+    if row.get("rollback"):       L.append(f"<b>Rollback:</b> {e(row['rollback'])}")
+    L.append(f"\n<b>Reply:</b> <code>{row['id']}: your answer</code>")
+    if n_left > 0: L.append(f"<i>({n_left} more queued after this)</i>")
+    return "\n".join(L)
