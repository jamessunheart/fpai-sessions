+async def recommend(title, why, build_spec, risk="low"):
+    """Proactive recommendation -> a decision carrying a build_spec but NOT armed.
+    needs_build stays false until James approves (record() arms it on an affirmative answer)."""
+    q = f"\U0001f4a1 {title} — {why} Build it?"
+    did = await add(q[:300], "build it|not now|tweak",
+                    {"why_surfaced": why[:300], "recommendation": "build it",
+                     "risk_class": risk, "proof_expected": "AI-reviewed branch, ready for your merge"})
+    async with connect() as conn:
+        async with conn.cursor() as cur:
+            await cur.execute("UPDATE brain_index.decisions SET build_spec=%s WHERE id=%s", (build_spec, did))
+    return did
